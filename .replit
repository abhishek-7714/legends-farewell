# Node only. The database is Replit's managed PostgreSQL (Database tool),
# reached through DATABASE_URL, so no local Postgres server is installed here.
modules = ["nodejs-20"]
run = "npm start"
entrypoint = "server/index.js"

[deployment]
run = ["npm", "start"]
deploymentTarget = "autoscale"

[[ports]]
localPort = 3000
externalPort = 80
